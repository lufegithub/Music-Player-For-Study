<%- include('../partials/head') %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <div class="small text-body-secondary"><a href="/playlists" class="link-secondary">Playlists</a></div>
    <h1 class="h3 mb-1"><%= playlist.name %></h1>
    <% if (playlist.description) { %><p class="text-body-secondary mb-0"><%= playlist.description %></p><% } %>
  </div>
  <form method="post" action="/playlists/<%= playlist.id %>/delete" onsubmit="return confirm('Excluir esta playlist? As faixas não serão apagadas.')">
    <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i> Excluir playlist</button>
  </form>
</div>

<% if (tracks.length === 0) { %>
  <p class="text-body-secondary">Playlist vazia. Adicione faixas pelo menu <i class="bi bi-three-dots-vertical"></i> na <a href="/">Biblioteca</a>.</p>
<% } else { %>
  <%- include('../partials/trackTable', { tracks, playlists: [], playlist }) %>
<% } %>

<%- include('../partials/foot') %>
