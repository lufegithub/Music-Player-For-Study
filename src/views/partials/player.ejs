<footer id="player" class="player-bar bg-body-tertiary border-top">
  <div class="container-fluid h-100">
    <div class="row h-100 align-items-center g-3">
      <!-- Capa + informações -->
      <div class="col-12 col-md-3 d-flex align-items-center gap-3 min-w-0">
        <img id="playerCover" src="/img/default-cover.svg" alt="Capa" class="player-cover rounded shadow-sm">
        <div class="min-w-0">
          <div id="playerTitle" class="fw-semibold text-truncate">Nenhuma faixa</div>
          <div id="playerArtist" class="small text-body-secondary text-truncate">—</div>
        </div>
      </div>

      <!-- Controles + barra de progresso -->
      <div class="col-12 col-md-6">
        <div class="d-flex justify-content-center align-items-center gap-2 mb-1">
          <button id="btnShuffle" class="btn btn-link text-body-secondary p-1" title="Aleatório"><i class="bi bi-shuffle"></i></button>
          <button id="btnPrev" class="btn btn-link text-body p-1 fs-5" title="Anterior"><i class="bi bi-skip-start-fill"></i></button>
          <button id="btnPlay" class="btn btn-light rounded-circle btn-play" title="Tocar/Pausar"><i class="bi bi-play-fill"></i></button>
          <button id="btnNext" class="btn btn-link text-body p-1 fs-5" title="Próxima"><i class="bi bi-skip-end-fill"></i></button>
          <button id="btnRepeat" class="btn btn-link text-body-secondary p-1" title="Repetir"><i class="bi bi-repeat"></i></button>
        </div>
        <div class="d-flex align-items-center gap-2 small text-body-secondary">
          <span id="timeCurrent" class="time">0:00</span>
          <input id="seek" type="range" class="form-range flex-grow-1" min="0" max="0" step="0.1" value="0">
          <span id="timeTotal" class="time">0:00</span>
        </div>
      </div>

      <!-- Volume -->
      <div class="col-md-3 d-none d-md-flex justify-content-end align-items-center gap-2">
        <button id="btnMute" class="btn btn-link text-body-secondary p-1" title="Mudo"><i class="bi bi-volume-up-fill"></i></button>
        <input id="volume" type="range" class="form-range volume" min="0" max="1" step="0.01" value="0.8">
      </div>
    </div>
  </div>
  <audio id="audio" preload="metadata"></audio>
</footer>
