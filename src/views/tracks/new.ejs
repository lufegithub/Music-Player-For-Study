<%- include('../partials/head') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <h1 class="h3 mb-4">Enviar faixa</h1>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form method="post" action="/tracks" enctype="multipart/form-data" class="card card-body gap-3">
      <div>
        <label for="audio" class="form-label">Arquivo de áudio <span class="text-danger">*</span></label>
        <input class="form-control" type="file" id="audio" name="audio" accept="audio/*" required>
        <div class="form-text">MP3, OGG, WAV, FLAC, M4A… Título, artista, álbum, duração e capa são lidos automaticamente dos metadados do arquivo quando os campos abaixo ficam em branco.</div>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <label for="title" class="form-label">Título</label>
          <input class="form-control" id="title" name="title" value="<%= values.title || '' %>" maxlength="200">
        </div>
        <div class="col-md-6">
          <label for="artist" class="form-label">Artista</label>
          <input class="form-control" id="artist" name="artist" value="<%= values.artist || '' %>" maxlength="150">
        </div>
        <div class="col-md-6">
          <label for="album" class="form-label">Álbum</label>
          <input class="form-control" id="album" name="album" value="<%= values.album || '' %>" maxlength="200">
        </div>
        <div class="col-md-3">
          <label for="genre_id" class="form-label">Gênero</label>
          <select class="form-select" id="genre_id" name="genre_id">
            <option value="">—</option>
            <% genres.forEach((g) => { %>
              <option value="<%= g.id %>" <%= String(values.genre_id) === String(g.id) ? 'selected' : '' %>><%= g.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label for="track_number" class="form-label">Nº da faixa</label>
          <input class="form-control" type="number" min="1" id="track_number" name="track_number" value="<%= values.track_number || '' %>">
        </div>
      </div>

      <div class="d-flex gap-3 align-items-start">
        <img id="coverPreview" src="/img/default-cover.svg" alt="Prévia da capa" class="rounded cover-preview">
        <div class="flex-grow-1">
          <label for="cover" class="form-label">Capa (opcional)</label>
          <input class="form-control" type="file" id="cover" name="cover" accept="image/*">
          <div class="form-text">Se não enviada, usa a capa embutida no áudio; se não houver, a do álbum; senão, a capa padrão.</div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <a href="/" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-success" type="submit"><i class="bi bi-upload"></i> Enviar</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('cover').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) document.getElementById('coverPreview').src = URL.createObjectURL(file);
  });
</script>

<%- include('../partials/foot') %>
