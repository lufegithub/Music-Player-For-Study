{
  "name": "music-player",
  "version": "0.1.0",
  "description": "Modelo inicial de player de músicas (MVC) com Node.js, Express, EJS, Bootstrap e MySQL",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/db.js init",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "multer": "2.0.2",
    "music-metadata": "7.14.0",
    "mysql2": "3.11.5"
  }
}
